# Copie este arquivo para `.env` e preencha com os dados do seu projeto no Supabase
# (Project Settings → API). Sem estas duas linhas o site roda em modo de demonstração,
# guardando os agendamentos só no navegador.
#
# A chave "anon" (ou "publishable") é pública por natureza: vai dentro do site e qualquer
# visitante pode vê-la. Quem protege os dados são as regras do banco (RLS e funções da
# migração). NUNCA coloque aqui a chave "service_role" (ou "secret").
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon
